{
  "title": "Spark Job Monitoring Dashboard",
  "uid": "spark-monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running Jobs",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(spark_application_activeJobs)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Completed Jobs",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(spark_application_completedJobs)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed Jobs",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(spark_application_failedJobs)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU Usage - Spark Containers",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\\\"spark-.*\\\"}[1m])) * 100",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Executors",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(spark_executor_cpuTime_total)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory Usage - Spark Containers",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_usage_bytes{name=~\\\"spark-.*\\\"}) / 1024 / 1024",
          "legendFormat": "Memory MB"
        }
      ]
    }
  ]
}